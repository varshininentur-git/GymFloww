# Reference only: Spring Boot does not load this file automatically.
# Set runtime variables in your shell or hosting provider's environment settings.
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:h2:file:/var/data/gymdb;DB_CLOSE_ON_EXIT=FALSE
SPRING_DATASOURCE_USERNAME=SET_IN_SECRET_MANAGER
SPRING_DATASOURCE_PASSWORD=SET_IN_SECRET_MANAGER
GYM_CORS_ALLOWED_ORIGINS=https://your-frontend.example
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
H2_CONSOLE_ENABLED=false
# Optional, only for initial administrator creation; remove after bootstrap.
GYM_ADMIN_USERNAME=
GYM_ADMIN_PASSWORD=
